# Copy this file to .env and replace both values with keys from Cloudflare Turnstile.
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Use a long random value in production.
APP_KEY=replace-with-a-long-random-application-key

# Local database connection. Keep real credentials in .env only.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jimenez_agri_system
DB_USERNAME=root
DB_PASSWORD=